cabal-version:      3.0
name:               epistemic-planner
version:            0.1.0.0
build-type:         Simple

executable epistemic-planner
  main-is:          EpPlanner.hs
  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -Wall -O1
  build-depends:
      base >=4.14 && <5,
      split,
      smcdel,
      HasCacBDD